{
  "name": "nonomy-mcp-vscode",
  "displayName": "Nonomy MCP",
  "description": "Runs the Nonomy MCP Roblox bridge server and shows its live dashboard as a VS Code tab instead of a browser window.",
  "version": "0.1.0",
  "publisher": "Nonomy-Development-Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/K3nD4rk-Code-Developer/Nonomy-MCP.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "lua",
    "roblox",
    "mcp",
    "dashboard"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nonomyMcp.openDashboard",
        "title": "Nonomy MCP: Open Dashboard",
        "icon": "$(radio-tower)"
      },
      {
        "command": "nonomyMcp.restartServer",
        "title": "Nonomy MCP: Restart Server"
      },
      {
        "command": "nonomyMcp.showLogs",
        "title": "Nonomy MCP: Show Server Logs"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./ && node scripts/copy-server.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.3",
    "@vscode/vsce": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "ws": "^8.18.3",
    "zod": "^4.3.4"
  }
}
